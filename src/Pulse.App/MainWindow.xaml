<Window x:Class="Pulse.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Pulse.App.Controls" Title="Nagi">
  <Border x:Name="Shell" CornerRadius="0" BorderThickness="0" Background="{ThemeResource CanvasBrush}" RequestedTheme="Dark">
    <Grid x:Name="Root" KeyDown="Root_KeyDown" Background="{ThemeResource HeaderGlowBrush}" RightTapped="Root_RightTapped" Tapped="Compact_Tapped" PointerEntered="PreviewRoot_Entered" PointerExited="PreviewRoot_Exited">
      <controls:HaloSurface x:Name="WindowSurface" AutomationProperties.AccessibilityView="Raw" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
      <Grid x:Name="AkenoDecor" Width="180" Height="190" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" Opacity=".13" Visibility="Collapsed"><Canvas><Path Data="M 170,22 C 72,-20 61,123 151,130 C 218,135 222,54 178,34" Stroke="#FFE7493E" StrokeThickness="3"/><Path Data="M 127,96 L 166,57 M 130,70 L 166,104 M 148,57 L 148,111 M 122,83 L 176,83" Stroke="#FFEB4B40" StrokeThickness="1"/><TextBlock Canvas.Left="149" Canvas.Top="137" Text="紅と影" FontFamily="Yu Mincho" FontSize="11" Foreground="#FFFF6757"/></Canvas></Grid>
      <Grid x:Name="EdgeDrop" Width="18" Height="132" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="EdgeDropButton" Style="{StaticResource QuietButton}" MinWidth="0" MinHeight="0" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="Dock_Click" AutomationProperties.Name="Reveal Nagi" AutomationProperties.HelpText="Hover to reveal compact controls. Click to keep them open, then click again to expand."><controls:PulseMark Width="12" Height="18" Opacity=".85"/></Button>
      </Grid>
      <ScrollViewer x:Name="RailViewport" Width="80" Height="420" HorizontalAlignment="Right" VerticalAlignment="Center" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" AutomationProperties.Name="Nagi vertical rail">
      <Grid x:Name="Compact" Width="80" Height="420" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="7,12" RowSpacing="7">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Button x:Name="CompactBrand" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Dock_Click" AutomationProperties.Name="Open Nagi control center" ToolTipService.ToolTip="Nagi · drag to move, click to pin, click again to expand"><StackPanel Orientation="Horizontal" Spacing="3"><controls:PulseMark Width="24" Height="24"/><FontIcon x:Name="DockPinIndicator" Glyph="&#xE718;" FontSize="8" Visibility="Collapsed"/></StackPanel></Button>
        <Button x:Name="RailSearchButton" Grid.Row="1" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" Click="Search_Click" AutomationProperties.Name="Quick search"><FontIcon Glyph="&#xE721;" FontSize="17"/></Button>
        <Button x:Name="CompactCpuButton" Grid.Row="2" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" Click="Expand_Click" PointerEntered="CpuPreview_Entered" AutomationProperties.Name="CPU usage"><StackPanel HorizontalAlignment="Center" Spacing="2"><TextBlock Text="CPU" FontSize="9" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock Text="{Binding CpuText}" FontSize="13" HorizontalAlignment="Center"/></StackPanel></Button>
        <Button x:Name="RailGpuButton" Grid.Row="3" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" Click="Expand_Click" PointerEntered="CpuPreview_Entered" AutomationProperties.Name="GPU usage"><StackPanel Spacing="2"><TextBlock Text="GPU" FontSize="9" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="RailGpuValue" Text="—" FontSize="13" HorizontalAlignment="Center"/></StackPanel></Button>
        <Button x:Name="CompactMediaButton" Grid.Row="4" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" Click="Expand_Click" PointerEntered="MediaPreview_Entered" AutomationProperties.Name="Media and audio"><StackPanel x:Name="CompactMediaContents" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center"><Border x:Name="CompactArtworkHost" Width="34" Height="34" CornerRadius="8" Visibility="Collapsed"><Image x:Name="CompactAlbumArt" AutomationProperties.Name="Media thumbnail" Stretch="UniformToFill"/></Border><TextBlock x:Name="CompactSecondaryLabel" Text="RAM" FontSize="9" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="CompactSecondaryValue" Text="{Binding RamText}" FontSize="10" HorizontalAlignment="Center"/><controls:MusicVisualizer x:Name="CompactMusicVisualizer" Width="36" Height="18"/><TextBlock x:Name="CompactAudioValue" Text="Audio" FontSize="9" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center"/></StackPanel></Button>
        <Button x:Name="RailWeatherButton" Grid.Row="5" Style="{StaticResource QuietButton}" Visibility="Collapsed" HorizontalAlignment="Stretch" Click="Weather_Click" AutomationProperties.Name="Weather"><StackPanel Spacing="2"><FontIcon Glyph="&#xE753;" FontSize="14"/><TextBlock x:Name="RailWeatherValue" Text="—" FontSize="11" HorizontalAlignment="Center"/></StackPanel></Button>
        <Button x:Name="RailMicrophoneButton" Grid.Row="5" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" Click="Microphone_Click" AutomationProperties.Name="Mute microphone"><FontIcon x:Name="RailMicrophoneIcon" Glyph="&#xE720;" FontSize="17"/></Button>
        <Button x:Name="CompactBatteryButton" Grid.Row="6" Style="{StaticResource QuietButton}" Click="Dock_Click" HorizontalAlignment="Stretch" AutomationProperties.Name="Battery status" ToolTipService.ToolTip="{Binding BatteryDetail}"><StackPanel Spacing="3" HorizontalAlignment="Center"><Grid x:Name="BatteryGlyph" Width="20" Height="12" HorizontalAlignment="Center"><Border Width="16" Height="10" HorizontalAlignment="Left" CornerRadius="2" BorderThickness="1" BorderBrush="{ThemeResource MutedBrush}"><Rectangle x:Name="BatteryFill" Height="6" Width="0" HorizontalAlignment="Left" Margin="1,0,0,0" Fill="{ThemeResource MutedBrush}"/></Border><Rectangle Width="2" Height="4" HorizontalAlignment="Right" Fill="{ThemeResource MutedBrush}"/></Grid><TextBlock Text="{Binding BatteryText}" FontSize="11" HorizontalAlignment="Center"/></StackPanel></Button>
      </Grid>
      </ScrollViewer>
      <Grid x:Name="PeekHost" Visibility="Collapsed" Width="350" Height="420" HorizontalAlignment="Center" VerticalAlignment="Top" Padding="14,12,14,8" RowSpacing="8" AutomationProperties.Name="Nagi hover preview">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Button HorizontalAlignment="Right" Margin="0,0,32,0" Style="{StaticResource QuietButton}" MinHeight="24" Padding="5,0" Content="Speakers" Click="Speakers_Click" AutomationProperties.Name="Choose preview speaker"/><TextBlock x:Name="PeekHeading" Text="System at a glance" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/><Button HorizontalAlignment="Right" Style="{StaticResource QuietButton}" MinHeight="24" MinWidth="24" Padding="4" Click="ClosePreview_Click" AutomationProperties.Name="Close preview"><FontIcon Glyph="&#xE711;" FontSize="10"/></Button></Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid>
            <StackPanel x:Name="SystemPeek" Spacing="8">
              <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><controls:MetricCard x:Name="PeekCpuMetric"/><controls:MetricCard x:Name="PeekRamMetric" Grid.Column="1"/></Grid>
              <TextBlock x:Name="PeekIntegrations" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource MutedBrush}"/><TextBlock x:Name="PeekNetwork" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel x:Name="MediaPeek" Visibility="Collapsed" Spacing="8">
              <Grid x:Name="PeekMediaInfo" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="88" Height="88" CornerRadius="16" Background="{ThemeResource AccentWashBrush}"><Grid><FontIcon Glyph="&#xE8D6;" FontSize="22" Foreground="{ThemeResource PulseAccentBrush}"/><Image x:Name="PeekAlbumArt" AutomationProperties.Name="Preview artwork" Stretch="UniformToFill"/></Grid></Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center"><TextBlock x:Name="PeekPlaybackState" FontSize="10" Foreground="{ThemeResource PulseAccentBrush}"/><TextBlock Text="{Binding MediaTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/><TextBlock Text="{Binding MediaArtist}" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
              </Grid>
              <StackPanel x:Name="PeekTransport" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14"><Button x:Name="PeekPreviousButton" Style="{StaticResource QuietButton}" Click="Previous_Click" AutomationProperties.Name="Preview previous track"><FontIcon Glyph="&#xE892;" FontSize="15"/></Button><Button x:Name="PeekPlayButton" Width="42" Height="38" CornerRadius="19" Background="{ThemeResource AccentWashBrush}" Click="Play_Click" AutomationProperties.Name="Preview play or pause"><FontIcon x:Name="PeekPlayIcon" Glyph="&#xE768;" FontSize="16" Foreground="{ThemeResource PulseAccentBrush}"/></Button><Button x:Name="PeekNextButton" Style="{StaticResource QuietButton}" Click="Next_Click" AutomationProperties.Name="Preview next track"><FontIcon Glyph="&#xE893;" FontSize="15"/></Button></StackPanel>
              <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="PeekMuteButton" Style="{StaticResource QuietButton}" Click="Mute_Click" AutomationProperties.Name="Preview mute output"><FontIcon x:Name="PeekMuteIcon" Glyph="&#xE767;" FontSize="14"/></Button><Slider x:Name="PeekVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="Volume_Changed" AutomationProperties.Name="Preview output volume"/><TextBlock x:Name="PeekVolumeValue" Grid.Column="2" FontSize="11" VerticalAlignment="Center"/></Grid>
              <controls:MusicVisualizer x:Name="PeekMusicVisualizer" Height="28"/><controls:AudioLevelMeter x:Name="PeekAudioMeter"/>

            </StackPanel>
          </Grid>
        </ScrollViewer>
        <Button Grid.Row="2" Content="Show more" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Style="{StaticResource QuietButton}" Background="{ThemeResource InsetBrush}" FontSize="12" Click="PreviewMore_Click" AutomationProperties.Name="Show more details"/>
      </Grid>
      <Grid x:Name="Expanded" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="22,18,22,16" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="Header" ColumnSpacing="7">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Width="36" Height="36" CornerRadius="12" Background="{ThemeResource AccentWashBrush}" BorderBrush="{ThemeResource EdgeBrush}" BorderThickness="0"><Grid><controls:PulseMark x:Name="HeaderMark" Width="23" Height="23"/><TextBlock x:Name="AkenoSeal" Text="凪" FontFamily="Yu Mincho" FontSize="15" LineHeight="15" TextAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource PulseAccentBrush}" Visibility="Collapsed"/></Grid></Border>
            <StackPanel Spacing="1"><TextBlock Text="Nagi" FontSize="22" FontWeight="SemiBold" CharacterSpacing="-45"/><TextBlock x:Name="BrandSubtitle" Text="A little space. More control." FontSize="10" Foreground="{ThemeResource MutedBrush}"/></StackPanel>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding Clock}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource MutedBrush}" Margin="0,0,5,0"/>
          <Button Grid.Column="2" Style="{StaticResource QuietButton}" Click="Search_Click" AutomationProperties.Name="Quick search" ToolTipService.ToolTip="Quick search · Alt + Space"><FontIcon Glyph="&#xE721;" FontSize="15"/></Button>
          <Button x:Name="HideHeaderButton" Grid.Column="3" Style="{StaticResource QuietButton}" Click="Hide_Click" AutomationProperties.Name="Hide Nagi" ToolTipService.ToolTip="Hide Nagi · Ctrl + Alt + H"><FontIcon Glyph="&#xED1A;" FontSize="15"/></Button>
          <Button Grid.Column="4" Style="{StaticResource QuietButton}" Click="Settings_Click" AutomationProperties.Name="Open settings" ToolTipService.ToolTip="Settings"><FontIcon Glyph="&#xE713;" FontSize="15"/></Button>
          <Button Grid.Column="5" Style="{StaticResource QuietButton}" Click="Collapse_Click" AutomationProperties.Name="Collapse Nagi" ToolTipService.ToolTip="Collapse · Escape"><FontIcon Glyph="&#xE70E;" FontSize="14"/></Button>
        </Grid>
        <Border Grid.Row="1" Background="{ThemeResource InsetBrush}" CornerRadius="13" Padding="3" BorderBrush="{ThemeResource EdgeBrush}" BorderThickness="0">
          <Grid x:Name="Tabs" ColumnSpacing="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button x:Name="OverviewTab" Content="Overview" Style="{StaticResource TabButton}" Click="Overview_Click"/>
            <Button x:Name="RulesTab" Grid.Column="1" Content="Profiles" Style="{StaticResource TabButton}" Click="Rules_Click"/>
            <Button x:Name="PreferencesTab" Grid.Column="2" Content="Settings" Style="{StaticResource TabButton}" Click="Settings_Click"/>
          </Grid>
        </Border>
        <Border x:Name="ContextCard" Grid.Row="2" Style="{StaticResource Card}" Padding="12,9">
          <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="30" Height="30" CornerRadius="10" Background="{ThemeResource InsetBrush}" VerticalAlignment="Center"><FontIcon Glyph="&#xE737;" FontSize="14" Foreground="{ThemeResource MutedBrush}"/></Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{Binding ContextText}" FontSize="10" Foreground="{ThemeResource MutedBrush}"/><TextBlock Text="{Binding ForegroundText}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/></StackPanel>
            <ComboBox x:Name="ProfilePicker" Grid.Column="2" MinWidth="116" FontSize="12" SelectionChanged="Profile_Changed" AutomationProperties.Name="Activity profile" VerticalAlignment="Center"><x:String>Automatic</x:String><x:String>Work</x:String><x:String>Gaming</x:String><x:String>Focus</x:String></ComboBox>
            <Button x:Name="LockButton" Grid.Column="3" Style="{StaticResource QuietButton}" Click="Lock_Click" ToolTipService.ToolTip="Lock or unlock the current profile" AutomationProperties.Name="Lock current profile" VerticalAlignment="Center"><FontIcon x:Name="LockIcon" Glyph="&#xE785;" FontSize="14"/></Button>
          </Grid>
        </Border>
        <ScrollViewer x:Name="ContentScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid>
            <StackPanel x:Name="HomePage" Spacing="10">
              <Border x:Name="WeatherCard" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel Spacing="6"><TextBlock x:Name="WeatherCityText" Text="Weather" FontSize="12" Foreground="{ThemeResource MutedBrush}"/><TextBlock x:Name="WeatherHeadline" Text="Checking weather…" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="WeatherDetailText" FontSize="11" TextWrapping="Wrap"/><HyperlinkButton Content="Weather by Open-Meteo · locations by GeoNames" NavigateUri="https://open-meteo.com/" FontSize="10" Padding="0"/></StackPanel></Border>
              <Grid x:Name="MetricsGrid" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><controls:MetricCard x:Name="CpuMetric"/><controls:MetricCard x:Name="RamMetric" Grid.Column="1"/></Grid>
              <Grid x:Name="NetworkRow" Margin="4,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE968;" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Network" FontSize="11" Foreground="{ThemeResource MutedBrush}"/><TextBlock x:Name="NetworkValue" Grid.Column="2" FontSize="11" Foreground="{ThemeResource MutedBrush}" Text="Sampling…"/></Grid>
              <Border x:Name="MediaCard" Style="{StaticResource Card}">
                <Grid ColumnSpacing="11"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Width="80" Height="80" CornerRadius="16" Background="{ThemeResource AccentWashBrush}" VerticalAlignment="Center"><Grid><FontIcon Glyph="&#xE8D6;" Foreground="{ThemeResource PulseAccentBrush}" FontSize="19"/><Image x:Name="AlbumArt" AutomationProperties.Name="Album artwork" Stretch="UniformToFill"/></Grid></Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="Now playing" FontSize="10" Foreground="{ThemeResource MutedBrush}"/><TextBlock Text="{Binding MediaTitle}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding MediaArtist}" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                    <Button x:Name="PreviousButton" Style="{StaticResource QuietButton}" MinWidth="26" Padding="4" Click="Previous_Click" AutomationProperties.Name="Previous track"><FontIcon Glyph="&#xE892;" FontSize="13"/></Button>
                    <Button x:Name="PlayButton" CornerRadius="18" Width="36" Height="36" Background="{ThemeResource AccentWashBrush}" BorderBrush="{ThemeResource EdgeBrush}" BorderThickness="0" Click="Play_Click" AutomationProperties.Name="Play or pause"><FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="14" Foreground="{ThemeResource PulseAccentBrush}"/></Button>
                    <Button x:Name="NextButton" Style="{StaticResource QuietButton}" MinWidth="26" Padding="4" Click="Next_Click" AutomationProperties.Name="Next track"><FontIcon Glyph="&#xE893;" FontSize="13"/></Button>
                  </StackPanel>
                </Grid>
              </Border>
              <Border x:Name="AudioCard" Style="{StaticResource Card}" Padding="12,9">
                <StackPanel Spacing="2"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding AudioDevice}" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="VolumeValue" Grid.Column="1" FontSize="11"/></Grid><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="MuteButton" Style="{StaticResource QuietButton}" Click="Mute_Click" AutomationProperties.Name="Mute output"><FontIcon x:Name="MuteIcon" Glyph="&#xE767;" FontSize="15"/></Button><Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="Volume_Changed" AutomationProperties.Name="Output volume"/></Grid><controls:MusicVisualizer x:Name="OutputMusicVisualizer"/><controls:AudioLevelMeter x:Name="OutputAudioMeter"/><Button Content="Speakers" Click="Speakers_Click" AutomationProperties.Name="Choose speaker"/></StackPanel>
              </Border>
              <Border x:Name="IntegrationCard" Style="{StaticResource Card}"><StackPanel Spacing="8"><TextBlock Text="System &amp; studio" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="IntegrationSummary" Text="Checking GPU and sensor providers…" FontSize="12" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Microphone" Click="Microphone_Click" AutomationProperties.Name="Toggle microphone mute"/><Button x:Name="ObsRecordButton" Content="OBS record" Click="ObsRecord_Click" IsEnabled="False" AutomationProperties.Name="Toggle OBS recording"/></StackPanel></StackPanel></Border>
              <Grid Margin="3,0"><TextBlock Text="Your shortcuts" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/><Button Content="Edit" Style="{StaticResource QuietButton}" Padding="5,0" MinHeight="24" HorizontalAlignment="Right" FontSize="11" Click="Actions_Click"/></Grid>
              <VariableSizedWrapGrid x:Name="QuickActionsPanel" Orientation="Horizontal" ItemWidth="148" ItemHeight="48" MaximumRowsOrColumns="3"/>
            </StackPanel>
            <StackPanel x:Name="RulesPage" Visibility="Collapsed" Spacing="14"/>
            <StackPanel x:Name="SettingsPage" Visibility="Collapsed" Spacing="14"/>
          </Grid>
        </ScrollViewer>
        <Grid Grid.Row="4" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="NoticeText" Text="{Binding Notice}" FontSize="10" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center"/><TextBlock x:Name="TrayStatusText" Text="Local &amp; private" FontSize="10" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center"/></StackPanel></Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
