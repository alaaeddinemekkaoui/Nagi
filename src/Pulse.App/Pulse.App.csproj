<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.0.0</Version>
    <AssemblyName>Nagi</AssemblyName>
    <RootNamespace>Pulse.App</RootNamespace>
    <Product>Nagi</Product>
    <Title>Nagi</Title>
    <Description>Nagi — your calm desktop companion</Description>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Nagi.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <ProjectReference Include="../Pulse.Core/Pulse.Core.csproj" />
    <ProjectReference Include="../Pulse.Infrastructure/Pulse.Infrastructure.csproj" />
    <ProjectReference Include="../Pulse.Windows/Pulse.Windows.csproj" />
  </ItemGroup>
  <ItemGroup><Content Include="Assets/Tools/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" /></ItemGroup>
  <ItemGroup><Content Include="../../scripts/Apply-NagiUpdate.ps1" Link="Apply-NagiUpdate.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Content Include="Assets/Nagi.*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" /></ItemGroup>
  <ItemGroup><Content Include="Assets/Akeno.*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" /></ItemGroup>
  <!-- The unpackaged WinUI publish pipeline omits app XBF/PRI files. Export them explicitly. -->
  <Target Name="IncludePulseXamlResourcesInPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_PulseResourceToPublish Include="$(TargetDir)**\*.xbf;$(TargetDir)$(AssemblyName).pri" />
      <_PulseAssetToPublish Include="$(TargetDir)Assets\**\*" Exclude="$(TargetDir)Assets\Pulse.*" />
      <ResolvedFileToPublish Include="@(_PulseResourceToPublish)">
        <RelativePath>%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="@(_PulseAssetToPublish)">
        <RelativePath>Assets\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
