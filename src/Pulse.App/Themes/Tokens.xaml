<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="CanvasBrush" Color="#18141823"/>
      <SolidColorBrush x:Key="SurfaceBrush" Color="#48313646"/>
      <SolidColorBrush x:Key="InsetBrush" Color="#30101420"/>
      <SolidColorBrush x:Key="EdgeBrush" Color="#1FFFFFFF"/>
      <SolidColorBrush x:Key="InkBrush" Color="#FFF5F6FA"/>
      <SolidColorBrush x:Key="MutedBrush" Color="#FFB5BAC9"/>
      <SolidColorBrush x:Key="AccentWashBrush" Color="#38E87389"/>
      <SolidColorBrush x:Key="SelectedTabBrush" Color="#28FFFFFF"/>
      <SolidColorBrush x:Key="PulseAccentBrush" Color="#FFFF8BA3"/>
      <LinearGradientBrush x:Key="GlassRimBrush" StartPoint="0,0" EndPoint=".6,1"><GradientStop Color="#68FFFFFF" Offset="0"/><GradientStop Color="#18FFFFFF" Offset=".45"/><GradientStop Color="#30FFFFFF" Offset="1"/></LinearGradientBrush>
      <LinearGradientBrush x:Key="HeaderGlowBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#12E98DA9"/><GradientStop Color="#008FAAFE" Offset="1"/></LinearGradientBrush>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="CanvasBrush" Color="#12F5F7FF"/>
      <SolidColorBrush x:Key="SurfaceBrush" Color="#76FFFFFF"/>
      <SolidColorBrush x:Key="InsetBrush" Color="#10526186"/>
      <SolidColorBrush x:Key="EdgeBrush" Color="#1C182A4C"/>
      <SolidColorBrush x:Key="InkBrush" Color="#FF20263A"/>
      <SolidColorBrush x:Key="MutedBrush" Color="#FF525F78"/>
      <SolidColorBrush x:Key="AccentWashBrush" Color="#18BC2855"/>
      <SolidColorBrush x:Key="SelectedTabBrush" Color="#B0FFFFFF"/>
      <SolidColorBrush x:Key="PulseAccentBrush" Color="#FFAC244C"/>
      <LinearGradientBrush x:Key="GlassRimBrush" StartPoint="0,0" EndPoint=".7,1"><GradientStop Color="#F0FFFFFF"/><GradientStop Color="#641C2946" Offset="1"/></LinearGradientBrush>
      <LinearGradientBrush x:Key="HeaderGlowBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#12E895AE"/><GradientStop Color="#009BB4F9" Offset="1"/></LinearGradientBrush>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Akeno">
      <SolidColorBrush x:Key="CanvasBrush" Color="#70100609"/>
      <SolidColorBrush x:Key="SurfaceBrush" Color="#BA211416"/>
      <SolidColorBrush x:Key="InsetBrush" Color="#7011080B"/>
      <SolidColorBrush x:Key="EdgeBrush" Color="#39ED554B"/>
      <SolidColorBrush x:Key="InkBrush" Color="#FFFFEDE7"/>
      <SolidColorBrush x:Key="MutedBrush" Color="#FFC6AFAD"/>
      <SolidColorBrush x:Key="AccentWashBrush" Color="#40C82F2A"/>
      <SolidColorBrush x:Key="SelectedTabBrush" Color="#60B6322E"/>
      <SolidColorBrush x:Key="PulseAccentBrush" Color="#FFFF493F"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="CanvasBrush" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="InsetBrush" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="EdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
      <SolidColorBrush x:Key="InkBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
      <SolidColorBrush x:Key="MutedBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
      <SolidColorBrush x:Key="AccentWashBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
      <SolidColorBrush x:Key="SelectedTabBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
      <SolidColorBrush x:Key="PulseAccentBrush" Color="{ThemeResource SystemColorHotlightColor}"/>
      <SolidColorBrush x:Key="GlassRimBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
      <SolidColorBrush x:Key="HeaderGlowBrush" Color="Transparent"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <Color x:Key="SystemAccentColor">#FFE77891</Color>
  <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#FFE77891"/>
  <x:Double x:Key="SpaceSmall">8</x:Double><x:Double x:Key="SpaceMedium">16</x:Double><x:Double x:Key="SpaceLarge">24</x:Double>
  <CornerRadius x:Key="CardRadius">18</CornerRadius>
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource EdgeBrush}"/>
    <Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/><Setter Property="Padding" Value="12"/>
  </Style>
  <Style x:Key="Eyebrow" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="CharacterSpacing" Value="20"/>
    <Setter Property="Foreground" Value="{ThemeResource MutedBrush}"/>
  </Style>
  <Style x:Key="QuietButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="11"/>
    <Setter Property="MinWidth" Value="34"/><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="8"/>
  </Style>
  <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="15,7"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
</ResourceDictionary>
